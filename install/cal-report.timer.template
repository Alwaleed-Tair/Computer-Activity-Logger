[Unit]
Description=Daily Computer Activity Logger reports

[Timer]
# Shortly after midnight: the previous day is over, so its report becomes FINAL.
OnCalendar=*-*-* 00:10:00
# If the computer was off at that time, run as soon as it is on again (no day is skipped).
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
